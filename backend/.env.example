PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=umma_hospital
# For Cloud Run with Cloud SQL, set to /cloudsql/PROJECT:REGION:INSTANCE.
# DB_SOCKET_PATH=
# Enable this if your managed MySQL provider requires TLS.
DB_SSL=false
# Optional provider CA certificate when DB_SSL=true.
# DB_SSL_CA=

# Generate a private random value of at least 32 characters.
SESSION_SECRET=replace_with_a_long_random_secret_value

# Optional: creates the first admin account on server startup if no admin exists.
ADMIN_NAME=Hospital Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Gmail SMTP example. Use a Google App Password, not your normal Gmail password.
